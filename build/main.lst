 125:project/src/main.c **** 
 126:project/src/main.c **** /*usmart专门用于调试*/
 127:project/src/main.c **** 
 128:project/src/main.c **** uint8_t usmart_set_pulse_width_us(uint32_t width_us)
 129:project/src/main.c **** {
 130:project/src/main.c ****   if ((width_us == 0U) || (width_us > MAX_PULSE_INDEX))
 131:project/src/main.c ****   {
 132:project/src/main.c ****     return USMART_PARMERR;
 133:project/src/main.c ****   }
 134:project/src/main.c **** 
 135:project/src/main.c ****   i = (uint16_t)width_us;
 136:project/src/main.c ****   tmr_period_value_set(TMR1, i * PULSE_HIGH_US * TMR1_TICKS_PER_US);
 137:project/src/main.c **** 
 138:project/src/main.c ****   OLED_ShowNum(3, 5, i, 3);
 139:project/src/main.c ****   OLED_ShowNum(2, 5, i * PULSE_HIGH_US, 3);
 140:project/src/main.c ****   at32_tmr1_pulse_start();      //开始发射脉冲
 141:project/src/main.c ****   at32_led_toggle(LED2);
 142:project/src/main.c **** 
 143:project/src/main.c ****   return USMART_OK;
 144:project/src/main.c **** }
