 164:project/src/main.c **** 
 165:project/src/main.c **** void send_data(u8 *buf,u16 len)
 166:project/src/main.c **** {
 167:project/src/main.c ****     memcpy(uart_tx_buf,buf,len);
 168:project/src/main.c ****     while (usart_flag_get(USART1,USART_TDBE_FLAG) == RESET);
 169:project/src/main.c ****     dma_channel_enable(DMA1_CHANNEL2,FALSE);
 170:project/src/main.c ****     dma_data_number_set(DMA1_CHANNEL2,len);
 171:project/src/main.c ****     dma_channel_enable(DMA1_CHANNEL2,TRUE);
 172:project/src/main.c **** }
