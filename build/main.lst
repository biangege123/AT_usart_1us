 104:project/src/main.c **** //这个完成了TMR1脉冲启动的准备工作
 105:project/src/main.c **** static void at32_tmr1_pulse_start(void)
 106:project/src/main.c **** {
 107:project/src/main.c ****   tmr_counter_enable(TMR1,FALSE);     //先禁用TMR1计数器
 108:project/src/main.c ****   tmr_counter_value_set(TMR1,0);      //设置TMR1计数器值=0
 109:project/src/main.c ****   tmr_flag_clear(TMR1,TMR_OVF_FLAG);  //清除TMR1的标志位：溢出中断标记
 110:project/src/main.c ****   tmr_counter_enable(TMR1,TRUE);      //后启用TMR1计数器
 111:project/src/main.c **** }
 112:project/src/main.c **** 
 113:project/src/main.c **** 
 114:project/src/main.c **** //这个完成了TMR8脉冲启动的准备工作
 115:project/src/main.c **** static void at32_tmr8_pulse_start(void)
 116:project/src/main.c **** {
 117:project/src/main.c ****   tmr_counter_enable(TMR8,FALSE);     //先禁用TMR1计数器
 118:project/src/main.c ****   tmr_counter_value_set(TMR8,0);      //设置TMR1计数器值=0
 119:project/src/main.c ****   tmr_flag_clear(TMR8,TMR_OVF_FLAG);  //清除TMR1的标志位：溢出中断标记
 120:project/src/main.c ****   tmr_counter_enable(TMR8,TRUE);      //后启用TMR1计数器
 121:project/src/main.c **** }
 122:project/src/main.c **** 
