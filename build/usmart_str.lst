  69:project/src/usmart_str.c **** /**
  70:project/src/usmart_str.c ****  * @brief       返回a^b的值
  71:project/src/usmart_str.c ****  * @param       a: 底数
  72:project/src/usmart_str.c ****  *              b: 指数
  73:project/src/usmart_str.c ****  * @retval      a^b
