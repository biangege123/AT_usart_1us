   6:project/src/usmart_str.c **** /**
   7:project/src/usmart_str.c ****  * @brief       字符串比较
   8:project/src/usmart_str.c ****  * @param       str1: 字符串1
   9:project/src/usmart_str.c ****  *              str2: 字符串2
  10:project/src/usmart_str.c ****  * @retval      0, 相等; 1, 不相等
  11:project/src/usmart_str.c ****  */
  12:project/src/usmart_str.c **** uint8_t usmart_strcmp(char *str1, char *str2)
  13:project/src/usmart_str.c **** {
  14:project/src/usmart_str.c ****     while (1)
  15:project/src/usmart_str.c ****     {
  16:project/src/usmart_str.c ****         if (*str1 != *str2)
  17:project/src/usmart_str.c ****         {
  18:project/src/usmart_str.c ****             return 1;               /* 不相等 */
  19:project/src/usmart_str.c ****         }
  20:project/src/usmart_str.c **** 
  21:project/src/usmart_str.c ****         if (*str1 == '\0')
  22:project/src/usmart_str.c ****         {
  23:project/src/usmart_str.c ****             break;                  /* 结束 */
  24:project/src/usmart_str.c ****         }
  25:project/src/usmart_str.c **** 
  26:project/src/usmart_str.c ****         str1++;
  27:project/src/usmart_str.c ****         str2++;
  28:project/src/usmart_str.c ****     }
  29:project/src/usmart_str.c **** 
  30:project/src/usmart_str.c ****     return 0;
