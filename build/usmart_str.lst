 203:project/src/usmart_str.c **** /**
 204:project/src/usmart_str.c ****  * @brief       得到指令名
 205:project/src/usmart_str.c ****  * @param       str: 源字符串
 206:project/src/usmart_str.c ****  *              cmdname: 指令名缓存
 207:project/src/usmart_str.c ****  *              nlen: 指令名长度
 208:project/src/usmart_str.c ****  *              maxlen: 缓存最大长度(包含结束符)
 209:project/src/usmart_str.c ****  * @retval      0, 成功; 其他, 失败
 210:project/src/usmart_str.c ****  */
 211:project/src/usmart_str.c **** uint8_t usmart_get_cmdname(char *str, char *cmdname, uint8_t *nlen, uint8_t maxlen)
 212:project/src/usmart_str.c **** {
 213:project/src/usmart_str.c ****     if (maxlen == 0)
 214:project/src/usmart_str.c ****     {
 215:project/src/usmart_str.c ****         return 1;
 216:project/src/usmart_str.c ****     }
 217:project/src/usmart_str.c **** 
 218:project/src/usmart_str.c ****     *nlen = 0;
 219:project/src/usmart_str.c **** 
 220:project/src/usmart_str.c ****     while (*str != ' ' && *str != '\0')
 221:project/src/usmart_str.c ****     {
 222:project/src/usmart_str.c ****         if (*nlen >= (uint8_t)(maxlen - 1U))
 223:project/src/usmart_str.c ****         {
 224:project/src/usmart_str.c ****             *cmdname = '\0';
 225:project/src/usmart_str.c ****             return 1;           /* 指令太长 */
 226:project/src/usmart_str.c ****         }
 227:project/src/usmart_str.c **** 
 228:project/src/usmart_str.c ****         *cmdname = *str;
 229:project/src/usmart_str.c ****         str++;
 230:project/src/usmart_str.c ****         cmdname++;
 231:project/src/usmart_str.c ****         (*nlen)++;
 232:project/src/usmart_str.c ****     }
 233:project/src/usmart_str.c **** 
 234:project/src/usmart_str.c ****     *cmdname = '\0';
 235:project/src/usmart_str.c ****     return 0;
 236:project/src/usmart_str.c **** }
