  88:project/src/usmart_str.c **** /**
  89:project/src/usmart_str.c ****  * @brief       字符串转数字
  90:project/src/usmart_str.c ****  *   @note      支持10进制、16进制(必须0X开头), 支持正负号
  91:project/src/usmart_str.c ****  * @param       str: 源字符串
  92:project/src/usmart_str.c ****  *              res: 转换结果
  93:project/src/usmart_str.c ****  * @retval      0, 成功;
  94:project/src/usmart_str.c ****  *              1, 含有非法字符;
  95:project/src/usmart_str.c ****  *              2, 16进制数据长度不足(0X后无数据);
  96:project/src/usmart_str.c ****  *              3, 16进制数据未以0X开头;
  97:project/src/usmart_str.c ****  *              4, 无有效数字
  98:project/src/usmart_str.c ****  */
  99:project/src/usmart_str.c **** uint8_t usmart_str2num(char *str, uint32_t *res)
 100:project/src/usmart_str.c **** {
 101:project/src/usmart_str.c ****     uint32_t t;
 102:project/src/usmart_str.c ****     uint8_t bnum = 0;           /* 数字位数 */
 103:project/src/usmart_str.c ****     char *p;
 104:project/src/usmart_str.c ****     uint8_t hexdec = 10;        /* 默认10进制 */
 105:project/src/usmart_str.c ****     uint8_t sign = 0;           /* 负数标志 */
 106:project/src/usmart_str.c **** 
 107:project/src/usmart_str.c ****     p = str;
 108:project/src/usmart_str.c ****     *res = 0;
 109:project/src/usmart_str.c **** 
 110:project/src/usmart_str.c ****     /* 处理符号 */
 111:project/src/usmart_str.c ****     if (*p == '-')
 112:project/src/usmart_str.c ****     {
 113:project/src/usmart_str.c ****         sign = 1;
 114:project/src/usmart_str.c ****         p++;
 115:project/src/usmart_str.c ****     }
 116:project/src/usmart_str.c ****     else if (*p == '+')
 117:project/src/usmart_str.c ****     {
 118:project/src/usmart_str.c ****         p++;
 119:project/src/usmart_str.c ****     }
 120:project/src/usmart_str.c **** 
 121:project/src/usmart_str.c ****     /* 检查字符串是否全部为合法数字 */
 122:project/src/usmart_str.c ****     while (1)
 123:project/src/usmart_str.c ****     {
 124:project/src/usmart_str.c ****         if ((*p <= '9' && *p >= '0') || (*p <= 'F' && *p >= 'A') || (*p == 'X' && bnum == 1))
 125:project/src/usmart_str.c ****         {
 126:project/src/usmart_str.c ****             if (*p >= 'A')
 127:project/src/usmart_str.c ****             {
 128:project/src/usmart_str.c ****                 hexdec = 16;    /* 存在A~F或者X, 按16进制处理 */
 129:project/src/usmart_str.c ****             }
 130:project/src/usmart_str.c ****             bnum++;
 131:project/src/usmart_str.c ****         }
 132:project/src/usmart_str.c ****         else if (*p == '\0')
 133:project/src/usmart_str.c ****         {
 134:project/src/usmart_str.c ****             break;
 135:project/src/usmart_str.c ****         }
 136:project/src/usmart_str.c ****         else
 137:project/src/usmart_str.c ****         {
 138:project/src/usmart_str.c ****             return 1;           /* 非法字符 */
 139:project/src/usmart_str.c ****         }
 140:project/src/usmart_str.c ****         p++;
 141:project/src/usmart_str.c ****     }
 142:project/src/usmart_str.c **** 
 143:project/src/usmart_str.c ****     p = str;
 144:project/src/usmart_str.c ****     if (sign)
ARM GAS  C:\Users\bians\AppData\Local\Temp\ccQ6wmSd.s 			page 4


 145:project/src/usmart_str.c ****     {
 146:project/src/usmart_str.c ****         p++;
 147:project/src/usmart_str.c ****     }
 148:project/src/usmart_str.c **** 
 149:project/src/usmart_str.c ****     if (hexdec == 16)
 150:project/src/usmart_str.c ****     {
 151:project/src/usmart_str.c ****         if (bnum < 3)
 152:project/src/usmart_str.c ****         {
 153:project/src/usmart_str.c ****             return 2;           /* 0X后面没有数据 */
 154:project/src/usmart_str.c ****         }
 155:project/src/usmart_str.c ****         if (*p == '0' && *(p + 1) == 'X')
 156:project/src/usmart_str.c ****         {
 157:project/src/usmart_str.c ****             p += 2;
 158:project/src/usmart_str.c ****             bnum -= 2;
 159:project/src/usmart_str.c ****         }
 160:project/src/usmart_str.c ****         else
 161:project/src/usmart_str.c ****         {
 162:project/src/usmart_str.c ****             return 3;           /* 16进制必须以0X开头 */
 163:project/src/usmart_str.c ****         }
 164:project/src/usmart_str.c ****     }
 165:project/src/usmart_str.c ****     else if (bnum == 0)
 166:project/src/usmart_str.c ****     {
 167:project/src/usmart_str.c ****         return 4;               /* 没有数字 */
 168:project/src/usmart_str.c ****     }
 169:project/src/usmart_str.c **** 
 170:project/src/usmart_str.c ****     while (1)
 171:project/src/usmart_str.c ****     {
 172:project/src/usmart_str.c ****         if (bnum)
 173:project/src/usmart_str.c ****         {
 174:project/src/usmart_str.c ****             bnum--;
 175:project/src/usmart_str.c ****         }
 176:project/src/usmart_str.c **** 
 177:project/src/usmart_str.c ****         if (*p <= '9' && *p >= '0')
 178:project/src/usmart_str.c ****         {
 179:project/src/usmart_str.c ****             t = *p - '0';
 180:project/src/usmart_str.c ****         }
 181:project/src/usmart_str.c ****         else
 182:project/src/usmart_str.c ****         {
 183:project/src/usmart_str.c ****             t = *p - 'A' + 10;
 184:project/src/usmart_str.c ****         }
 185:project/src/usmart_str.c **** 
 186:project/src/usmart_str.c ****         *res += t * usmart_pow(hexdec, bnum);
 187:project/src/usmart_str.c ****         p++;
 188:project/src/usmart_str.c **** 
 189:project/src/usmart_str.c ****         if (*p == '\0')
 190:project/src/usmart_str.c ****         {
 191:project/src/usmart_str.c ****             break;
 192:project/src/usmart_str.c ****         }
 193:project/src/usmart_str.c ****     }
 194:project/src/usmart_str.c **** 
 195:project/src/usmart_str.c ****     if (sign)
 196:project/src/usmart_str.c ****     {
 197:project/src/usmart_str.c ****         *res = (uint32_t)(0U - *res);    /* 负数取补码 */
 198:project/src/usmart_str.c ****     }
 199:project/src/usmart_str.c **** 
 200:project/src/usmart_str.c ****     return 0;
 201:project/src/usmart_str.c **** }
