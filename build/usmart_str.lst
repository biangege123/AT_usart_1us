  75:project/src/usmart_str.c **** uint32_t usmart_pow(uint8_t a, uint8_t b)
  76:project/src/usmart_str.c **** {
  77:project/src/usmart_str.c ****     uint32_t res = 1;
  78:project/src/usmart_str.c **** 
  79:project/src/usmart_str.c ****     while (b)
  80:project/src/usmart_str.c ****     {
  81:project/src/usmart_str.c ****         res *= a;
  82:project/src/usmart_str.c ****         b--;
  83:project/src/usmart_str.c ****     }
  84:project/src/usmart_str.c **** 
  85:project/src/usmart_str.c ****     return res;
  86:project/src/usmart_str.c **** }
